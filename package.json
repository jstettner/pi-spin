{
  "name": "pi-spin",
  "version": "0.0.0",
  "private": true,
  "description": "Pi extensions: /carry moves conversation text across the session tree; /spin repeats a task from a fixed point until a saved check says it is done",
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package"],
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "src",
    "extensions",
    "examples"
  ],
  "pi": {
    "extensions": ["./extensions/*.ts"]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepare": "effect-tsgo patch --typescript",
    "repos": "rm -rf repos/effect && git clone --quiet --depth 1 -c advice.detachedHead=false --branch effect@$(node -p \"require('effect/package.json').version\") https://github.com/Effect-TS/effect.git repos/effect"
  },
  "dependencies": {
    "@earendil-works/pi-codemode": "1.0.0",
    "effect": "4.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@earendil-works/pi-tui": "1.0.0",
    "@effect/tsgo": "0.47.2",
    "@effect/vitest": "4.0.0",
    "@types/node": "^24.13.6",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
